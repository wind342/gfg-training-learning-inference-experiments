{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "burst-equivariance-state-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cut_step",
    "evaluation_interval",
    "current_train_accuracy",
    "current_validation_accuracy",
    "recent_validation_accuracy",
    "gradient_burst_peaks",
    "gradient_burst_peak_norms",
    "translation_equivariance_history",
    "current_translation_equivariance",
    "bursts_needed",
    "predicted_burst_centers",
    "predicted_burst_evaluation_steps",
    "predicted_transition_step",
    "phase"
  ],
  "properties": {
    "schema": {"const": "burst-equivariance-state-v1"},
    "cut_step": {"type": "integer", "minimum": 0, "maximum": 10000},
    "evaluation_interval": {"const": 100},
    "current_train_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "current_validation_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "recent_validation_accuracy": {"type": "array", "maxItems": 4, "items": {"type": "object"}},
    "gradient_burst_peaks": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "gradient_burst_peak_norms": {"type": "array", "items": {"type": "number", "minimum": 0}},
    "translation_equivariance_history": {"type": "array", "maxItems": 6, "items": {"type": "object"}},
    "current_translation_equivariance": {"type": ["number", "null"]},
    "bursts_needed": {"type": "integer", "minimum": 1, "maximum": 2},
    "predicted_burst_centers": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "integer"}},
    "predicted_burst_evaluation_steps": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "integer"}},
    "predicted_transition_step": {"type": "integer"},
    "phase": {"const": "SYMMETRY_NUCLEATION"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability-formation-state-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cut_step",
    "train_accuracy",
    "validation_accuracy",
    "rule_probability",
    "rule_probability_velocity_per_grid",
    "rule_margin_mean",
    "rule_margin_q10",
    "rule_positive_margin_fraction",
    "cyclic_rule_recovered",
    "last_burst_step",
    "next_burst_step",
    "cycle_interval_estimate",
    "mature_cycle_interval",
    "major_burst_count",
    "current_gradient_norm",
    "second_moment_mean",
    "relative_adam_step",
    "reservoir_depletion",
    "optimizer_learning_rate",
    "optimizer_weight_decay",
    "predicted_transition_step",
    "transition_already_observed"
  ],
  "properties": {
    "schema": {"const": "capability-formation-state-v1"},
    "cut_step": {"type": "integer", "minimum": 1, "maximum": 10000},
    "train_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "validation_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "rule_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "rule_probability_velocity_per_grid": {"type": "number", "minimum": 0},
    "rule_margin_mean": {"type": "number"},
    "rule_margin_q10": {"type": "number"},
    "rule_positive_margin_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "cyclic_rule_recovered": {"type": "boolean"},
    "last_burst_step": {"type": "integer", "minimum": 0},
    "next_burst_step": {"type": "integer", "minimum": 0},
    "cycle_interval_estimate": {"type": "number", "exclusiveMinimum": 0},
    "mature_cycle_interval": {"type": "number", "exclusiveMinimum": 0},
    "major_burst_count": {"type": "integer", "minimum": 0},
    "current_gradient_norm": {"type": "number", "minimum": 0},
    "second_moment_mean": {"type": "number", "minimum": 0},
    "relative_adam_step": {"type": "number", "minimum": 0},
    "reservoir_depletion": {"type": "number", "minimum": 0},
    "optimizer_learning_rate": {"type": "number", "minimum": 0},
    "optimizer_weight_decay": {"type": "number", "minimum": 0},
    "predicted_transition_step": {"type": "integer", "minimum": 1, "maximum": 10000},
    "transition_already_observed": {"type": "boolean"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gfg-capability-formation-state-v1",
  "title": "Capability formation finite state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cut_step",
    "evaluation_interval",
    "phase",
    "transition_seen_step",
    "train_accuracy_tail",
    "validation_accuracy_tail",
    "validation_grid_progress",
    "validation_margin_median",
    "validation_margin_q10",
    "burst_centers_tail",
    "burst_peak_tail",
    "learning_rate",
    "weight_decay",
    "asymptotic_burst_period",
    "weight_scale_reserve",
    "reserve_multiplier_per_cycle"
  ],
  "properties": {
    "schema": {"const": "gfg-capability-formation-state-v1"},
    "cut_step": {"type": "integer", "minimum": 0, "maximum": 10000},
    "evaluation_interval": {"type": "integer", "minimum": 1},
    "phase": {
      "enum": [
        "MEMORIZATION",
        "RULE_CIRCUIT_ACCUMULATION",
        "FORMATION_BURST",
        "GENERALIZED"
      ]
    },
    "transition_seen_step": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 10000},
        {"type": "null"}
      ]
    },
    "train_accuracy_tail": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "validation_accuracy_tail": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "validation_grid_progress": {"type": "number", "minimum": 0},
    "validation_margin_median": {"type": ["number", "null"]},
    "validation_margin_q10": {"type": ["number", "null"]},
    "burst_centers_tail": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "integer", "minimum": 0, "maximum": 10000}
    },
    "burst_peak_tail": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "number", "minimum": 0}
    },
    "learning_rate": {"type": "number", "minimum": 0},
    "weight_decay": {"type": "number", "minimum": 0},
    "asymptotic_burst_period": {"type": "number", "exclusiveMinimum": 0},
    "weight_scale_reserve": {"type": "number", "minimum": 0},
    "reserve_multiplier_per_cycle": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gfg-capability-burst-margin-state-v1",
  "title": "Clipped-burst rule-margin mechanism state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "cut_step",
    "train_accuracy",
    "validation_accuracy",
    "rule_margin_q10",
    "rule_margin_q25",
    "rule_margin_median",
    "recent_validation_accuracy",
    "formation_status",
    "formed_step_if_observed",
    "cycles_remaining",
    "clip_threshold",
    "major_burst_count",
    "last_burst_peak_step",
    "last_burst_period",
    "burst_period_delta",
    "burst_phase",
    "last_gradient_total_norm",
    "optimizer_tension",
    "forecast_horizon_step"
  ],
  "properties": {
    "schema": {"const": "gfg-capability-burst-margin-state-v1"},
    "cut_step": {"type": "integer", "minimum": 0, "maximum": 10000},
    "train_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "validation_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "rule_margin_q10": {"type": "number"},
    "rule_margin_q25": {"type": "number"},
    "rule_margin_median": {"type": "number"},
    "recent_validation_accuracy": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "formation_status": {"enum": ["MEMORIZED", "FORMED"]},
    "formed_step_if_observed": {"type": ["integer", "null"]},
    "cycles_remaining": {"type": "integer", "minimum": 0, "maximum": 4},
    "clip_threshold": {"type": "number", "exclusiveMinimum": 0},
    "major_burst_count": {"type": "integer", "minimum": 0},
    "last_burst_peak_step": {"type": "integer", "minimum": 0},
    "last_burst_period": {"type": "number", "minimum": 0},
    "burst_period_delta": {"type": "number"},
    "burst_phase": {"enum": ["ACTIVE", "QUIESCENT"]},
    "last_gradient_total_norm": {"type": "number", "minimum": 0},
    "optimizer_tension": {"type": "number", "minimum": 0, "maximum": 2},
    "forecast_horizon_step": {"const": 10000}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/capture-completeness-audit-v1",
  "type": "object",
  "required": [
    "capture_audit_id",
    "execution_run_id",
    "declared_contract_id",
    "overall_status",
    "scopes",
    "schema_version"
  ],
  "properties": {
    "capture_audit_id": {
      "type": "string",
      "pattern": "^capaudit1_[0-9a-f]{64}$"
    },
    "execution_run_id": {"type": "string"},
    "declared_contract_id": {"type": "string"},
    "overall_status": {
      "enum": [
        "CAPTURE_COMPLETE",
        "CAPTURE_PARTIAL",
        "CAPTURE_CONFLICT",
        "CAPTURE_NOT_ESTABLISHED"
      ]
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scope_id",
          "status",
          "reason_codes",
          "concurrency_inference_allowed",
          "scheduler_completeness_basis",
          "global_scheduler_completeness_machine_proved",
          "concurrency_scope",
          "program_order_exactness"
        ],
        "properties": {
          "scope_id": {"type": "string"},
          "status": {
            "enum": [
              "CAPTURE_COMPLETE",
              "CAPTURE_PARTIAL",
              "CAPTURE_CONFLICT",
              "CAPTURE_NOT_ESTABLISHED"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {"type": "string"}
          },
          "concurrency_inference_allowed": {"type": "boolean"},
          "scheduler_completeness_basis": {
            "const": "DECLARED_CONTROLLED_EXECUTOR_PROFILE"
          },
          "global_scheduler_completeness_machine_proved": {
            "const": false
          },
          "concurrency_scope": {
            "const": "CONTROLLED_CAPTURE_SCOPE_ONLY"
          },
          "program_order_exactness": {
            "type": "object",
            "required": [
              "status",
              "expected_adjacent_edges",
              "receipt_edges",
              "relation_edges",
              "evidence_edges",
              "missing_edges",
              "extra_edges",
              "duplicate_sequence_indexes",
              "binding_issues",
              "receipt_relation_evidence_one_to_one"
            ],
            "properties": {
              "status": {"enum": ["PASS", "FAIL"]},
              "expected_adjacent_edges": {"type": "array"},
              "receipt_edges": {"type": "array"},
              "relation_edges": {"type": "array"},
              "evidence_edges": {"type": "array"},
              "missing_edges": {"type": "array"},
              "extra_edges": {"type": "array"},
              "duplicate_sequence_indexes": {"type": "array"},
              "binding_issues": {"type": "array"},
              "receipt_relation_evidence_one_to_one": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "schema_version": {"const": "capture-completeness-audit-v1"}
  }
}

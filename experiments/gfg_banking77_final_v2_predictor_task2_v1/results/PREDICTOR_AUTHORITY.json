  "predict_source": "def predict(self,params,delta):\n        z=[];one=[];two=[]\n        for k in range(0,self.padded,256):\n            x=self.x[k:k+256]\n            fn=lambda p:functional(p,x)\n            f0,f1=torch.func.jvp(fn,(params,),(delta,))\n            _,f2=torch.func.jvp(lambda p:torch.func.jvp(fn,(p,),(delta,))[1],(params,),(delta,))\n            z.append(f0);one.append(f1);two.append(f2)\n        return tuple(torch.cat(a)[:self.n].detach() for a in (z,one,two))",
